{
    "manifest_version": 3,
    "name": "Presto for Trello",
    "version": "1.3.41",
    "description": "Customize Trello checklists: colors, badges, hide comments, and copy items between cards.",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png",
        "144": "icons/icon-144.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png",
            "144": "icons/icon-144.png"
        }
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://trello.com/*"],
            "js": ["dom-bus.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://trello.com/*"],
            "css": ["content.css", "staging.css", "toast.css"],
            "js": ["toast.js", "content.js", "staging.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["chips.json"],
            "matches": ["https://trello.com/*"]
        }
    ]
}
